{
  "dense_backend": "chromadb",
  "chroma_db_dir": "data/indexes/chroma",
  "chroma_collection": "research_mind_chunks",
  "embedding_model": "BAAI/bge-small-en-v1.5",
  "embedding_dim": 384,
  "query_instruction": "Represent this sentence for searching relevant passages: ",
  "top_k_dense": 20,
  "top_k_bm25": 20,
  "rrf_k": 60,
  "dense_weight": 1.0,
  "lexical_weight": 1.0,
  "final_top_k": 10,
  "deduplicate_parent_chunks": true,
  "enable_section_filtering": true,
  "excluded_sections": [
    "Header",
    "References",
    "Bibliography",
    "Acknowledgements"
  ]
}
