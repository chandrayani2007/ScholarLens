# Research Mind Application Environment Configuration
# Copy to .env for local development. Never commit real credentials to git.

# Database Connection (PostgreSQL or SQLite fallback for development/testing)
DATABASE_URL=sqlite:///./data/app.db

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider Configuration ("mock", "openai", "gemini")
LLM_PROVIDER=mock

# LLM Provider API Keys (Used when LLM_PROVIDER="openai" or "gemini")
OPENAI_API_KEY=
GEMINI_API_KEY=
